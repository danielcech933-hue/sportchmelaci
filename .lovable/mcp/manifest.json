{
  "version": 1,
  "sdk_version": "0.26.2",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://kvkqljvflrrbpsjhphdl.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "game-scoreboard-hub",
      "version": "0.1.0",
      "title": "Game Scoreboard Hub"
    },
    "tools": [
      {
        "name": "get_my_profile",
        "title": "Get my profile",
        "description": "Return the signed-in player's nickname, ELO, dollar balance and slot credits.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_matches",
        "title": "List matches",
        "description": "List matches from the scoreboard. Use scope 'upcoming' for scheduled fixtures, 'recent' for finished matches, or 'all'. Optionally filter by sport.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "scope": {
              "default": "recent",
              "description": "Which matches to return.",
              "type": "string",
              "enum": [
                "upcoming",
                "recent",
                "all"
              ]
            },
            "sport": {
              "description": "Filter by sport key, e.g. 'tennis'.",
              "type": "string",
              "minLength": 1
            },
            "limit": {
              "default": 10,
              "description": "Maximum number of matches.",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_scoreboard",
        "title": "Get scoreboard",
        "description": "Return the community player ranking ordered by ELO rating.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "default": 10,
              "description": "How many players to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_tournaments",
        "title": "List tournaments",
        "description": "List tournaments with their sport, format, status and scheduled start.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "default": 10,
              "description": "How many tournaments to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "send_lobby_message",
        "title": "Send lobby chat message",
        "description": "Post a message to the public SportChmeláci lobby chat as the signed-in player.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "content": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "description": "Message text to post in the lobby chat."
            }
          },
          "required": [
            "content"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
